# Variables d'Environnement (Template)
# Copiez ce fichier vers .env et renseignez les valeurs requises.
# ATTENTION : Ne JAMAIS commiter de fichier .env contenant des secrets réels dans Git !

# Environnement de l'application (development | test | production)
NODE_ENV=development
PORT=3000

# Base de Données
DATABASE_URL="postgresql://user:password@localhost:5432/app_db?schema=public"

# Authentification & Chiffrement
# Générer avec : openssl rand -base64 32
JWT_SECRET="remplacez_par_un_secret_aleatoire_de_minimum_32_caracteres"
JWT_EXPIRES_IN="1h"

# Sécurité & CORS (Origines autorisées séparées par des virgules)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Redis / Cache & Idempotence
REDIS_URL="redis://localhost:6379"
